# Copy this file to .env.local and fill in the values
# Get database credentials from: https://console.neon.tech

# PostgreSQL connection via Neon pooler (used by the app at runtime)
DATABASE_URL=

# PostgreSQL direct connection — no pooler (used by TypeORM CLI for migrations)
DATABASE_URL_UNPOOLED=

# Neon branch name
NEON_BRANCH=production
